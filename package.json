{
  "name": "sunix",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "native:android": "expo run:android",
    "native:ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --write .",
